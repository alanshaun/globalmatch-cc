generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  sellerProfiles    SellerProfile[]
  searchSessions    SearchSession[]
  buyerMatches      BuyerMatch[]
  seenCompanies     UserSeenCompany[]
  emailOutreach     EmailOutreach[]
}

model SellerProfile {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  productName        String
  productDescription String
  hsCode             String?
  category           String?
  pricePositioning   String?  // high/mid/low
  certifications     Json     @default("[]")
  coreAdvantages     Json     @default("[]")
  rawInputType       String   // file|url|text
  rawInputContent    String?
  searchKeywords     Json     @default("[]")
  createdAt          DateTime @default(now())

  searchSessions SearchSession[]
}

model SearchSession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  sellerProfileId String
  sellerProfile   SellerProfile @relation(fields: [sellerProfileId], references: [id])
  targetCountries String[]
  targetCount     Int      @default(20)
  status          String   @default("pending") // pending|running|completed|failed
  resultCount     Int      @default(0)
  isFallback      Boolean  @default(false)
  fallbackReason  String?
  auditLog        Json     @default("{}")
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  buyerMatches BuyerMatch[]
}

model BuyerMatch {
  id               String   @id @default(cuid())
  sessionId        String
  session          SearchSession @relation(fields: [sessionId], references: [id])
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  companyName      String
  website          String?
  domain           String
  country          String?
  industry         String?
  matchScore       Int      @default(0)
  fitScore         Int      @default(0)
  intentScore      Int      @default(0)
  reachabilityScore Int     @default(0)
  confidenceScore  Int      @default(0)
  matchReason      String?
  buyerBusiness    String?
  whyTheyNeedUs    String?
  supplierWeakness String?
  intentSignals    Json     @default("[]")
  contacts         Json     @default("[]")
  emailDraft       Json     @default("{}")
  dataSource       String   @default("serpapi") // customs|serpapi|ddg|pdl|cache
  fromCache        Boolean  @default(false)
  shipmentCount    Int      @default(0)
  lastShipment     DateTime?
  isFavorited      Boolean  @default(false)
  createdAt        DateTime @default(now())

  emailOutreach EmailOutreach[]
}

model UserSeenCompany {
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  companyDomain String
  firstSeenAt  DateTime @default(now())

  @@id([userId, companyDomain])
}

model EmailOutreach {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  buyerMatchId      String
  buyerMatch        BuyerMatch @relation(fields: [buyerMatchId], references: [id])
  subject           String
  subjectVariant    String?  // A or B
  body              String
  status            String   @default("pending") // pending|sent|opened|replied
  sentAt            DateTime?
  openedAt          DateTime?
  repliedAt         DateTime?
  openCount         Int      @default(0)
  trackingPixelId   String   @default(cuid())
  firstSentenceType String?

  @@index([status])
  @@index([sentAt])
}

model SuccessPattern {
  id                     String   @id @default(cuid())
  sellerCategory         String?
  buyerType              String?
  buyerCountry           String?
  buyerSize              String?
  intentSignalsPresent   Boolean  @default(false)
  supplierWeaknessPresent Boolean @default(false)
  firstSentenceType      String?
  timingType             String?
  resultedInReply        Boolean  @default(false)
  createdAt              DateTime @default(now())
}

model SearchCache {
  cacheKey  String   @id
  results   Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}
