RESEND_API_KEY=re_placeholder
EMAIL_FROM=onboarding@resend.dev

# ── Database (docker-compose 自动创建，不用改) ────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/globalmatch

# ── App ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3001
